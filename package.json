{
  "name": "fortune-cookie-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:hosting": "node scripts/build-hosting-sites.js",
    "test": "node --test test_*.js",
    "predeploy:check": "node scripts/predeploy-check.js && npm test && npm --prefix functions test && npm run build && npm run build:hosting",
    "mobile:check": "node scripts/mobile-config-check.js",
    "appstore:check": "node scripts/app-store-check.js",
    "admob:functions-env": "node scripts/sync-admob-function-env.js",
    "android:signing:init": "node scripts/generate-android-upload-key.js",
    "preview": "vite preview",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "firebase-tools": "^15.24.0",
    "sharp": "^0.35.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-firebase/app-check": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@revenuecat/purchases-capacitor": "^13.2.4",
    "firebase": "^12.16.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@opentelemetry/core": "2.10.0",
    "brace-expansion": "5.0.9",
    "tar": "7.5.22",
    "uuid": "11.1.1"
  }
