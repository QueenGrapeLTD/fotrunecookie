    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^2.13.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2-rc.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "11.1.1"
  },
  "private": true
}
